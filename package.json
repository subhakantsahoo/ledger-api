{
  "name": "ledger-api",
  "version": "1.0.0",
  "description": "Transaction ledger API built with Node.js, Express and MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^8.24.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
